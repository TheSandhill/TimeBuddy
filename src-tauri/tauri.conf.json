{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeBuddy",
  "version": "0.1.0",
  "identifier": "com.renszandbergen.timebuddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TimeBuddy",
        "width": 520,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:timebuddy.db"]
    },
    "updater": {
      "endpoints": [
        "https://github.com/TheSandhill/TimeBuddy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNTU3N0NEMzQ1NThGMzEKUldReGoxVTB6WGRWL3krcFY5Q2syTWlieTBWRWRVYWFJNkNEZzYxNUNMbHJPb2NpL292VjJUWVEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
